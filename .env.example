# Supabase Configuration (Public)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# The Gemini API Key should ONLY be set in the Supabase Edge Function environment
# Do NOT put it here for frontend use if using Vite, or at least do not prefix with VITE_
# Edge Function environment variables are set via Supabase CLI
GEMINI_API_KEY=your_gemini_api_key_here
